{
  "cli": {
    "version": ">= 12.0.0"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal"
    },
    "preview": {
      "env": {
        "NODE_VERSION": "22",
        "EXPO_PUBLIC_API_URL": "https://fintrack-162y.onrender.com"
      },
      "android": {
        "image": "latest",
        "buildType": "apk"
      },
      "ios": {
        "image": "latest"
      },
      "distribution": "internal"
    },
    "production": {
      "env": {
        "NODE_VERSION": "22"
      },
      "android": {
        "image": "latest"
      },
      "ios": {
        "image": "latest"
      },
      "autoIncrement": true
    }
  },
  "submit": {
    "production": {}
  }
}
