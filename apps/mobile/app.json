{
  "expo": {
    "name": "FinTrack",
    "slug": "fintrack",
    "version": "1.0.1",
    "scheme": "fintrack",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.fintrack.app",
      "buildNumber": "1",
      "infoPlist": {
        "NSFaceIDUsageDescription": "Allow FinTrack to use Face ID for fast and secure access."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.fintrack.app",
      "versionCode": 4,
      "permissions": [
        "USE_BIOMETRIC",
        "USE_FINGERPRINT"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      "expo-local-authentication",
      "expo-apple-authentication",
      [
        "react-native-android-widget",
        {
          "widgets": [
            {
              "name": "FinanceWidget",
              "label": "FinTrack Budgets",
              "minWidth": "250dp",
              "minHeight": "110dp",
              "description": "Quick view of your active budgets",
              "previewImage": "./assets/icon.png",
              "updatePeriodMillis": 1800000
            }
          ]
        }
      ],
      "expo-font",
      "expo-web-browser"
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "122cfd88-7d98-4210-be30-38371d482683"
      }
    }
  }
}
